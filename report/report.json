    {
      "category": "event",
      "in": "com/thomas7520/macrokeybinds/FabricMacroMod",
      "detail": "KeyMappingHelper.registerKeyMapping",
      "horizon": "hook `key`",
      "status": "auto",
      "note": "Mojang-named variant of KeyBindingHelper."
    },
    {
      "category": "event",
      "in": "com/thomas7520/macrokeybinds/event/MacroEvent",
      "detail": "ClientTickEvents.END_CLIENT_TICK",
      "horizon": "hook `tick`",
      "status": "auto",
      "note": "The Fabric API layer (jfabricapi.rs) runs START_CLIENT_TICK, then the level ticks (START/END_LEVEL_TICK, while in a world), then END_CLIENT_TICK, from Horizon's tick hook, in the window's Game only."
    },
    {
      "category": "event",
      "in": "com/thomas7520/macrokeybinds/event/MacroEvent",
      "detail": "ClientPlayConnectionEvents.JOIN",
      "horizon": "hook `tick`",
      "status": "auto",
      "note": "The Fabric API layer runs JOIN on the window's first tick with a player after none, DISCONNECT on the first tick without one after."
    },
    {
      "category": "event",
      "in": "com/thomas7520/macrokeybinds/event/MacroEvent",
      "detail": "ClientPlayConnectionEvents.DISCONNECT",
      "horizon": "hook `tick`",
      "status": "auto",
      "note": "The Fabric API layer runs JOIN on the window's first tick with a player after none, DISCONNECT on the first tick without one after."
    },
